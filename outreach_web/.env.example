# Local Next.js configuration. Do not commit the copied .env.local file.
# Use the same Clerk development instance and user ID as the backend's root .env.
APP_ENV=development
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
LOCAL_DEV_USER_ID=

# The frontend proxy calls this API origin from the server.
BACKEND_URL=http://127.0.0.1:8000

# Keep empty for local user-ID authentication. In production set this to a
# random secret shared only with the API; it signs short-lived per-user proxy
# assertions and must never use a NEXT_PUBLIC_ name.
BACKEND_IDENTITY_SECRET=

# Optional public base used by client code before requests are routed through the proxy.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Public Google Analytics 4 measurement ID (for example, G-XXXXXXXXXX).
# The measurement ID is public; do not put an Analytics API secret here.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
