# Local FastAPI configuration. Do not commit the copied .env file.
# Both current database layers require this PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Keep this stable for any database that stores encrypted Gmail credentials.
# Generate a new value only for a new database:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=replace-with-a-stable-fernet-key

# Local Clerk user ID. It must match LOCAL_DEV_USER_ID in outreach_web/.env.local.
# Leave BACKEND_IDENTITY_SECRET blank for local development.
APP_ENV=development
LOCAL_DEV_USER_ID=
# Set only for local development when testing the administrator-only OAuth
# configuration endpoint. Production admin access comes from Clerk metadata.
LOCAL_DEV_IS_ADMIN=false
BACKEND_IDENTITY_SECRET=
# Optional explicit CORS regex. Production defaults to the public frontend;
# local development defaults to localhost only.
CORS_ALLOW_ORIGIN_REGEX=
OUTREACH_SAFE_LOCAL_MODE=true
OUTREACH_ALLOW_DELIVERY=false
# Do not apply schema migrations from a local process to a shared production database.
RUN_DATABASE_MIGRATIONS=false
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000
WORKER_TICK_TOKEN=

# Gmail OAuth client. Use GMAIL_CREDENTIALS_JSON for a serverless API, or a file
# available to a persistent local/API process.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_CREDENTIALS_JSON=

# Optional Gmail activity tracking through Google Cloud Pub/Sub.
GMAIL_PUBSUB_TOPIC=projects/your-project-id/topics/outreach-gmail-events
GMAIL_PUBSUB_PUSH_AUDIENCE=https://api.example.com/api/webhooks/gmail
GMAIL_PUBSUB_PUSH_SERVICE_ACCOUNT=outreach-gmail-push@your-project-id.iam.gserviceaccount.com
